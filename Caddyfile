:80 {
    # API Requests zum Backend
    handle /api/* {
        reverse_proxy backend:8001
    }
    
    # Alle anderen Requests zum Frontend
    handle {
        reverse_proxy frontend:80
    }
}

# Sobald DNS aktiv, diese Zeilen aktivieren:
