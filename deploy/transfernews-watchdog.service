[Unit]
Description=Transfernews bounded backend watchdog
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /opt/transfernews-ops/watchdog/watchdog.py --apply
TimeoutStartSec=100
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/transfernews-ops/watchdog
StandardOutput=journal
StandardError=journal
